{
  "permissions": {
    "allow": ["Bash(agy:*)"]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Edit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "node .claude/hooks/guard-protected-paths.cjs"
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Edit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "node .claude/hooks/format-file.cjs 2>/dev/null || true"
          },
          {
            "type": "command",
            "command": "node .claude/hooks/test-related.cjs 2>/dev/null || true"
          }
        ]
      }
    ]
  }
}