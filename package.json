{
  "name": "nutrimind",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "Türkçe, koyu temalı, mobil öncelikli beslenme takip uygulaması. Öğrenen alias hafızası.",
  "homepage": "https://nutri.emrullah.xyz",
  "license": "UNLICENSED",
  "engines": {
    "node": ">=22.0.0",
    "pnpm": ">=10.0.0"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/Emrullah/nutrimind.git"
  },
  "keywords": [
    "nutrition",
    "meal-tracking",
    "turkish",
    "pwa",
    "tdee",
    "macro"
  ],
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "check:i18n": "node scripts/check-i18n.mjs",
    "test": "vitest run",
    "format": "prettier --write .",
    "deploy": "bash deploy.sh"
  },
  "dependencies": {
    "@sentry/react": "^10.71.0",
    "barcode-detector": "^3.2.2",
    "i18next": "^26.4.0",
    "lucide-react": "^1.28.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-i18next": "^17.0.12",
    "zxing-wasm": "3.1.3"
  },
  "devDependencies": {
    "@capacitor/android": "^8.5.0",
    "@capacitor/cli": "^8.5.0",
    "@capacitor/core": "^8.5.0",
    "@types/node": "^22.10.5",
    "@types/react": "^18.3.18",
    "@types/react-dom": "^18.3.5",
    "@vitejs/plugin-react": "^4.3.4",
    "autoprefixer": "^10.4.20",
    "postcss": "^8.4.49",
    "prettier": "^3.4.2",
    "tailwindcss": "^3.4.17",
    "typescript": "^5.7.3",
    "vite": "^6.0.7",
    "vitest": "^4.1.10"
  },
  "onlyBuiltDependencies": [
    "esbuild"
  ]
}
