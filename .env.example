[TEMPLATE]
# Bu dosyayı .env olarak kopyala ve gerçek değerleri doldur. .env gitignore'da,
# asla commit'lenmez.

# --- Eski monorepo'dan kalan yer tutucular (hiçbir kod tarafından okunmuyor) ---
DB_HOST=127.0.0.1
DB_PORT=3307
DB_USER=nutrimind
DB_PASSWORD=nutrimind
DB_NAME=nutrimind
DB_ROOT_PASSWORD=nutrimind_root

API_PORT=8787
API_HOST=127.0.0.1
WEB_ORIGIN=http://localhost:5173

# --- Faz 2 + fallback zinciri: AI entegrasyonu (server/ai.js) ---
# Metin zinciri: OpenRouter → OpenCode → Ollama Cloud → Gemini (tier1→tier2→tier3)
# → Cloudflare AI Gateway (deneysel, son).
# Görsel zinciri: yalnızca Gemini tier'ları (vision-destekli modeller).
# none = kapalı (kill-switch) | gemini = yalnız Gemini (tier1) | auto = tam zincir.
NUTRIMIND_LLM_PROVIDER=none
# Plan-dahili/ücretsiz modeller önce denenir; her adım sırayla gider, ilk 200 durur.
# https://aistudio.google.com/apikey — ücretsiz/metin modelleri (2026-09-24 doğrulandı).
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.6-flash
# Zincirin 2. ve 3. Gemini kademeleri — Google kotayı MODEL BAZINDA ayrı takip
# ediyor, yani tier1 dolsa bile mevcutturlar. Model isimleri zamanla emekliye
# ayrılabilir (bkz. aiDiscovery — otomatik tazelenir).
# GEMINI_TIER2_MODEL=gemini-3.5-flash
# GEMINI_TIER3_MODEL=gemini-flash-lite-latest
# https://openrouter.ai — free modelleri `:free` sonekiyle ya da `openrouter/free`
# yönlendiricisiyle kullanılır. Günlük ~50 istek sınırı (kredi yoksa).
OPENROUTER_API_KEY=
# OPENROUTER_MODEL=openrouter/free
# https://opencode.ai/auth — tek güvenilir free metin modeli: space-bunny-free.
OPENCODE_API_KEY=
OPENCODE_MODEL=space-bunny-free
# https://ollama.com — Ollama Cloud (native /api/chat). Plan-dahili ücretsiz küme:
# gemma4:31b, gpt-oss:120b/20b, nemotron-3-*. "Ücretsiz" = anahtar planına dahil.
OLLAMA_CLOUD_API_KEY=
# OLLAMA_CLOUD_MODEL=gemma4:31b
# Deneysel — Cloudflare AI Gateway. Yalnızca `gemma-2b-it-lora` ücretsiz LoRA'sı
# tutarlı JSON üretir. Hesap id zorunlu; boşsa adım sessizce devre dışı kalır.
# CLAUDEFLARE_API_KEY=
# CLAUDEFLARE_ACCOUNT_ID=
# Bu eşiğin altındaki confidence'lı öğeler istemciye needsReview:true ile döner.
NUTRIMIND_CONFIDENCE_THRESHOLD=0.8
# Opsiyonel — server/ai.js'in varsayılanları: dakikada N istek (belirtilmemişse
# yukarıdaki sayı), 15sn zaman aşımı (fallback adımları 40sn — FALLBACK_TIMEOUT_MS).
# NUTRI_AI_RATE_PARSE=10
# NUTRI_AI_RATE_GEMINI_TIER2=10
# NUTRI_AI_RATE_GEMINI_TIER3=15
# NUTRI_AI_RATE_VISION=15
# NUTRI_AI_RATE_OPENROUTER=15
# NUTRI_AI_RATE_OPENCODE=10
# NUTRI_AI_RATE_OLLAMA=10
# NUTRI_AI_RATE_CLAUDEFLARE=5
# NUTRI_AI_TIMEOUT_MS=15000
# NUTRI_AI_FALLBACK_TIMEOUT_MS=40000
# Periyodik free-model taraması (server/aiDiscovery.js): sağlayıcı listelerini
# düzenli aralıkla tara, canlı modeli cache'le. 15 dk altı clamp'lanır.
# NUTRI_AI_DISCOVER_INTERVAL_MS=21600000

# --- Opsiyonel — zincir bütçesi, devre kesici, model keşfi (2026-09-21 olayı) ---
#
# ⚠️ ZAMAN PENCERESİ DEĞİŞMEZİ (bkz. docs/operations/ai.md):
#   NUTRI_AI_BUDGET_MS  <  nginx /api/ penceresi (30 sn)  <  istemci sınırı (35 sn)
# nginx bu vhost'ta `location ^~ /api/ { proxy_read_timeout 30s; }` ile sabit. Bütçe bu
# pencereyi aşarsa kullanıcı BİZİM hatamızı hiç görmez: nginx gövdesiz 504 döner, istemci
# bunu "AI servisi zaman aşımına uğradı" diye gösterir — 2026-09-21'de tam olarak bu oldu
# ve zincir 67 sn sürdü. Değişmez `server/ai.test.js` içinde test edilir.
#
# NUTRI_AI_BUDGET_MS=25000        # TÜM adımlar için toplam süre; her adımın zaman aşımı
#                                 # bu bütçenin KALANIYLA kırpılır.
# NUTRI_AI_MIN_STEP_MS=2500       # Kalan süre bunun altındaysa adım HİÇ başlatılmaz.
# NUTRI_AI_VENDOR_5XX_STREAK=2    # Aynı sağlayıcının art arda N kademesi 5xx/zaman aşımı
#                                 # verirse kalan kademeleri atlanır (sağlayıcı geneli arıza).
# NUTRI_AI_API_WINDOW_MS=30000    # Yalnızca değişmez kapısı için: nginx penceresi.
#
# MODEL ADLARI ARTIK SABİT DEĞİL: bir kademe model seviyesinde düşerse (400/404/410 —
# sağlayıcılar ücretsiz modelleri habersiz emekliye ayırıyor: llama-3.1-8b → 410 Gone,
# deepseek-v4-flash-free → 400) uygulama sağlayıcının kendi listesinden aday süzüp
# (OpenCode'da `-free` sonekliler önce) 1×1 PNG'lik tek-jetonluk istekle YOKLAR ve
# çalışanı 6 saat önbelleğe alır. Yukarıdaki GEMINI_MODEL/NVIDIA_NIM_MODEL/OPENCODE_MODEL
# değerleri bu yüzden "ilk aday"dır, sabit gerçek değil.
# NUTRI_AI_AUTOMODEL=1            # 0 = keşif kapalı (ölü model adında ısrar edilir).
# NUTRI_AI_MODEL_TTL_MS=21600000      # Başarılı keşif önbelleği (6 saat).
# NUTRI_AI_MODEL_NEGATIVE_TTL_MS=900000  # Başarısız keşif (15 dk).
# NUTRI_AI_DISCOVER_BUDGET_MS=8000    # Bir keşif turunun üst sınırı.
# NUTRI_AI_PROBE_TIMEOUT_MS=4000      # Tek aday yoklamasının üst sınırı.
# NUTRI_AI_MAX_PROBES=3               # Tur başına en fazla kaç aday yoklanır.
#
# Devre kesici: art arda düşen adım bir süre HİÇ denenmez. 2026-09-21'de ölü NIM vision
# adımı HER istekte 40 sn bekletiyordu; bu katman sayesinde üçüncü denemeden sonra atlanır.
# NUTRI_AI_BREAKER_MS=600000              # Devrenin açık kalma süresi (10 dk).
# NUTRI_AI_BREAKER_TIMEOUTS=3             # Kaç ardışık zaman aşımı devreyi açar.
# NUTRI_AI_BREAKER_PROVIDER_ERRORS=5      # Kaç ardışık sağlayıcı 5xx'i devreyi açar.
# NUTRI_AI_BREAKER_REQUEST_ERRORS=3       # Kaç ardışık 400/422 devreyi açar.

# --- Faz D/E: çok kullanıcı + kimlik doğrulama (server/authRoutes.js) ---
#
# ⚠️ İKİSİ DE VARSAYILAN OLARAK KAPALI. Kod prod'a gitse bile kimlik özelliği,
# bilinçli olarak açılana kadar inaktif kalır — uygulama bugünkü gibi davranır.

# "1" = kimlik doğrulama açık. Başka her değer: /api/auth/me geçirgen döner
# (authDisabled:true), diğer kimlik uçları 503.
NUTRIMIND_AUTH_ENABLED=0

# "1" = yeni kayıt açık. Kapalıyken /api/auth/register 403 döner.
# Kişisel bir uygulamada bunu 0 tutmak doğru: hesabın parolası
# `node server/setpassword.js <e-posta> <parola>` ile kuruluyor, yani sahibin
# hesabına giden HİÇBİR açık HTTP yolu yok.
#
# "İzinli E-postalar" listesi (Ayarlar'dan yönetilir) DOLUYSA kayıt yalnızca
# listedeki e-postalarla yapılabilir — listede olmayanlar Google ve parola
# yollarından da reddedilir. Liste BOŞSA bu bayrak tek başına karar verir.
# Önerilen kurulum: 1 + listeye kişi ekle (liste boşken herkes kayıt olabilir).
NUTRIMIND_ALLOW_SIGNUP=0

# İki işi var:
#  (1) Mevcut verinin atanacağı hesabın e-postası (yalnızca göç ANINDA okunur).
#      Boş bırakılırsa `owner@nutrimind.local` yer tutucusu kullanılır ve
#      setpassword.js ilk çalıştığında gerçek e-postayla değiştirilir.
#  (2) "İzinli E-postalar" listesini yönetebilecek yönetici (her istekte okunur):
#      bu e-postayla giriş yapan hesap, Ayarlar'da listeyi görür ve düzenler.
# NUTRIMIND_OWNER_EMAIL=

# HTTPS'te "1" YAP. Çerez adı `__Host-nm_session` olur; bu önek tarayıcıya
# Secure + Path=/ + Domain-yok şartlarını zorla doğrulatır. Yerel http testinde
# 0 bırakılmalı, aksi hâlde tarayıcı çerezi tamamen reddeder.
# NUTRI_SECURE_COOKIE=1

# CSRF köken kontrolü için izin verilen origin. ASLA Host başlığından
# türetilmemeli (istemci kontrolünde). Örn: https://nutri.emrullah.xyz
# NUTRIMIND_PUBLIC_ORIGIN=

# Oturum ömrü (gün). Kayan yenileme: son uzatmadan bir günden fazla geçtiyse uzar.
# NUTRI_SESSION_DAYS=30

# scrypt maliyeti. Küçük sunucuda giriş yavaşsa 16384'e düşürülebilir; eski
# parolalar yine doğrulanır (parametreler karmanın içinde saklanıyor).
# NUTRI_SCRYPT_N=32768

# --- Faz H: Google ile giriş (server/googleAuth.js) ---
#
# Google Cloud Console > Credentials > OAuth client ID (Web application) ile
# üretilir; indirilen `client_secret_*.json` dosyasındaki değerler buraya kopyalanır.
# O JSON dosyası .gitignore'da — kod onu OKUMAZ, yalnızca bu iki değişkeni okur.
#
# ⚠️ Console'da KAYITLI yönlendirme adresi ile aşağıdaki NUTRIMIND_PUBLIC_ORIGIN
# birebir tutmalı. Kullanılan yol: <origin>/api/auth/callback/google
#
# İkisi de boşsa Google girişi kapalıdır: /api/auth/google/start 503 döner ve
# giriş ekranı Google düğmesini hiç göstermez (/api/auth/me `googleEnabled`
# alanıyla bildiriyor).
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Kapsam yalnızca `openid email profile` — hassas OLMAYAN kapsamlar, Google'ın
# doğrulama incelemesini tetiklemez. Consent ekranı "Testing" modunda
# bırakılabilir: test kullanıcı listesi hazır bir allowlist olarak çalışır.
# (Yenileme tokenı istenmiyor, o yüzden "Testing'de refresh token 7 günde dolar"
# uyarısı bu uygulamayı ilgilendirmiyor.)

# --- Faz I: Crash raporlama (Sentry) ---
# Sentry.io'dan proje oluştur, DSN'i buraya kopyala. Boşsa Sentry noop.
VITE_SENTRY_DSN=
