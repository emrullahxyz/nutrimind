# Bu dosyayı .env olarak kopyala ve gerçek değerleri doldur. .env gitignore'da,
# asla commit'lenmez.

# --- Eski monorepo'dan kalan yer tutucular (hiçbir kod tarafından okunmuyor) ---
DB_HOST=127.0.0.1
DB_PORT=3307
DB_USER=nutrimind
DB_PASSWORD=nutrimind
DB_NAME=nutrimind
DB_ROOT_PASSWORD=nutrimind_root

API_PORT=8787
API_HOST=127.0.0.1
WEB_ORIGIN=http://localhost:5173

# --- Faz 2 + fallback zinciri: AI entegrasyonu (server/ai.js) ---
# Gemini (3 kademe: tier1 → tier2 → tier3) → NVIDIA NIM → OpenCode Zen (yalnızca
# metin ucunda). Her adım sırayla denenir, ilk başarılı (200) sonucu kullanılır.
# none = kapalı (kill-switch) | gemini = yalnız Gemini (tier1) | nim = yalnız NVIDIA NIM
# | auto = tam fallback zinciri.
NUTRIMIND_LLM_PROVIDER=none
# https://aistudio.google.com/apikey adresinden alınır. Boşsa (gemini/auto modda,
# ya da auto'da Gemini'nin 3 kademesi de) zincirdeki bir sonraki sağlayıcıya
# (NIM/OpenCode) düşülür.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-flash-latest
# Zincirin 2. ve 3. Gemini kademeleri — Google kotayı MODEL BAZINDA ayrı takip
# ediyor, yani tier1 dolsa bile mevcutturlar. Aşağıdaki varsayılanlar bu
# projede canlı doğrulandı (2026-08-07); Google zamanla model isimlerini
# değiştirebilir/emekli edebilir, doğrulamadan güvenme.
# GEMINI_TIER2_MODEL=gemini-3.5-flash
# GEMINI_TIER3_MODEL=gemini-flash-lite-latest
# https://build.nvidia.com adresinden alınır. Boşsa (nim/auto modda) zincirdeki
# NIM adımı atlanır.
# Not: hesabın erişebildiği model NVIDIA'nın katalog/hesap yetkilendirmesine göre
# değişir — build.nvidia.com'dan kendi anahtarınla hangi modellerin 200 döndüğünü
# doğrula (ör. "google/gemma-3-*" ailesi bazı hesaplarda 404 "Not found for account"
# verebiliyor). Aşağıdaki varsayılanlar bu projede doğrulanmış, çalışan modellerdir.
NVIDIA_NIM_API_KEY=
NVIDIA_NIM_MODEL=meta/llama-3.1-8b-instruct
# Görsel (kamera/etiket/galeri) zincirinin NIM adımı — vision-destekli model.
# NVIDIA_NIM_VISION_MODEL=meta/llama-3.2-90b-vision-instruct
# https://opencode.ai/auth adresinden alınır (kredi kartı istemiyor). Metin
# zincirinin SON adımı — ücretsiz modellerin hiçbiri görsel desteklemediği için
# yalnızca /api/ai/parse'ta (metin) kullanılır, /api/ai/vision'da değil.
OPENCODE_API_KEY=
# OPENCODE_MODEL=deepseek-v4-flash-free
# Bu eşiğin altındaki confidence'lı öğeler istemciye needsReview:true ile döner.
NUTRIMIND_CONFIDENCE_THRESHOLD=0.8
# Opsiyonel — server/ai.js'in varsayılanları: dakikada N istek (belirtilmemişse
# yukarıdaki sayı), 15sn zaman aşımı (NIM fallback adımları 40sn).
# NUTRI_AI_RATE_PARSE=10
# NUTRI_AI_RATE_GEMINI_TIER2=10
# NUTRI_AI_RATE_GEMINI_TIER3=15
# NUTRI_AI_RATE_VISION=15
# NUTRI_AI_RATE_NIM=10
# NUTRI_AI_RATE_NIM_VISION=5
# NUTRI_AI_RATE_OPENCODE=10
# NUTRI_AI_TIMEOUT_MS=15000
# NUTRI_AI_NIM_TIMEOUT_MS=40000

# --- Faz D/E: çok kullanıcı + kimlik doğrulama (server/authRoutes.js) ---
#
# ⚠️ İKİSİ DE VARSAYILAN OLARAK KAPALI. Kod prod'a gitse bile kimlik özelliği,
# bilinçli olarak açılana kadar inaktif kalır — uygulama bugünkü gibi davranır.

# "1" = kimlik doğrulama açık. Başka her değer: /api/auth/me geçirgen döner
# (authDisabled:true), diğer kimlik uçları 503.
NUTRIMIND_AUTH_ENABLED=0

# "1" = yeni kayıt açık. Kapalıyken /api/auth/register 403 döner.
# Kişisel bir uygulamada bunu 0 tutmak doğru: hesabın parolası
# `node server/setpassword.js <e-posta> <parola>` ile kuruluyor, yani sahibin
# hesabına giden HİÇBİR açık HTTP yolu yok.
#
# "İzinli E-postalar" listesi (Ayarlar'dan yönetilir) DOLUYSA kayıt yalnızca
# listedeki e-postalarla yapılabilir — listede olmayanlar Google ve parola
# yollarından da reddedilir. Liste BOŞSA bu bayrak tek başına karar verir.
# Önerilen kurulum: 1 + listeye kişi ekle (liste boşken herkes kayıt olabilir).
NUTRIMIND_ALLOW_SIGNUP=0

# İki işi var:
#  (1) Mevcut verinin atanacağı hesabın e-postası (yalnızca göç ANINDA okunur).
#      Boş bırakılırsa `owner@nutrimind.local` yer tutucusu kullanılır ve
#      setpassword.js ilk çalıştığında gerçek e-postayla değiştirilir.
#  (2) "İzinli E-postalar" listesini yönetebilecek yönetici (her istekte okunur):
#      bu e-postayla giriş yapan hesap, Ayarlar'da listeyi görür ve düzenler.
# NUTRIMIND_OWNER_EMAIL=

# HTTPS'te "1" YAP. Çerez adı `__Host-nm_session` olur; bu önek tarayıcıya
# Secure + Path=/ + Domain-yok şartlarını zorla doğrulatır. Yerel http testinde
# 0 bırakılmalı, aksi hâlde tarayıcı çerezi tamamen reddeder.
# NUTRI_SECURE_COOKIE=1

# CSRF köken kontrolü için izin verilen origin. ASLA Host başlığından
# türetilmemeli (istemci kontrolünde). Örn: https://nutri.emrullah.xyz
# NUTRIMIND_PUBLIC_ORIGIN=

# Oturum ömrü (gün). Kayan yenileme: son uzatmadan bir günden fazla geçtiyse uzar.
# NUTRI_SESSION_DAYS=30

# scrypt maliyeti. Küçük sunucuda giriş yavaşsa 16384'e düşürülebilir; eski
# parolalar yine doğrulanır (parametreler karmanın içinde saklanıyor).
# NUTRI_SCRYPT_N=32768

# --- Faz H: Google ile giriş (server/googleAuth.js) ---
#
# Google Cloud Console > Credentials > OAuth client ID (Web application) ile
# üretilir; indirilen `client_secret_*.json` dosyasındaki değerler buraya kopyalanır.
# O JSON dosyası .gitignore'da — kod onu OKUMAZ, yalnızca bu iki değişkeni okur.
#
# ⚠️ Console'da KAYITLI yönlendirme adresi ile aşağıdaki NUTRIMIND_PUBLIC_ORIGIN
# birebir tutmalı. Kullanılan yol: <origin>/api/auth/callback/google
#
# İkisi de boşsa Google girişi kapalıdır: /api/auth/google/start 503 döner ve
# giriş ekranı Google düğmesini hiç göstermez (/api/auth/me `googleEnabled`
# alanıyla bildiriyor).
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Kapsam yalnızca `openid email profile` — hassas OLMAYAN kapsamlar, Google'ın
# doğrulama incelemesini tetiklemez. Consent ekranı "Testing" modunda
# bırakılabilir: test kullanıcı listesi hazır bir allowlist olarak çalışır.
# (Yenileme tokenı istenmiyor, o yüzden "Testing'de refresh token 7 günde dolar"
# uyarısı bu uygulamayı ilgilendirmiyor.)
